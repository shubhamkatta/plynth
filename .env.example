# Environment
APP_ENV=development
APP_NAME=product-platform
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_PREFIX=/api/v1
# JSON array of allowed browser origins. Must be explicit (never "*") because
# credentialed requests (cookies / Authorization with credentials: "include")
# require a specific origin allow-list. Include every web frontend that calls
# the API. For the Acme marketing site (product slug acme-practice) that is:
#   https://example.com, https://www.example.com  (+ the CF Pages preview origin,
#   e.g. https://acme.pages.dev, and http://localhost:4321 for local dev).
# CORS_ORIGINS=["https://example.com","https://www.example.com","https://acme.pages.dev","http://localhost:4321"]
CORS_ORIGINS=["http://localhost:3000"]

# Security — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_MIN_LENGTH=12

# Database
DATABASE_URL=postgresql+asyncpg://platform:platform@db:5432/platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# Billing
BILLING_PROVIDER=stripe
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Tenancy
DEFAULT_TRIAL_DAYS=14
GRACE_PERIOD_DAYS=7
TRIAL_EXPIRY_BUFFER_DAYS=1
INVITE_TTL_DAYS=7
PUBLIC_BASE_URL=https://api.example.com
# Transactional email: "log" (default) or "ses". SES needs a verified sender.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=

# --- Outbound-email branding -------------------------------------------------
# Every brand string in a transactional email comes from here. Unset, they fall
# back to a plain unbranded set, so an unconfigured deployment still sends
# correct mail — these are not placeholders you must fill in. Each can also be
# overridden per-send through the render context.
BRAND_NAME=Acme
# Shown after the name in the footer ("Acme — <tagline>"). Empty = name alone.
BRAND_TAGLINE=
# Why the recipient is getting this. Empty = "...an account with <BRAND_NAME>."
BRAND_FOOTER_NOTE=
# One sentence on what the product does, used in the invite. Empty omits it.
BRAND_PITCH=
# The same idea in the second person, for the invite's "once you're in".
BRAND_PITCH_INSIDE=
# A promise worth making up front, shown in the welcome. Empty omits it.
BRAND_PROMISE=
# The welcome email's day-one steps. Either a JSON array (must start with `[`)
# or — preferred in an env file, because it needs no quoting at all — a
# pipe-separated list. Simple inline HTML allowed. Empty uses a generic set.
# BRAND_WELCOME_STEPS=<strong>First.</strong> Do this.|<strong>Second.</strong> Then this.
BRAND_WELCOME_STEPS=
# SES configuration set attached to every send. Without one, SES has nowhere to
# publish bounce/complaint events and deliverability problems are invisible —
# the gap AWS asks about when refusing production access. The set
# "plynth-transactional" exists in ap-south-1 with a CloudWatch event
# destination for SEND/DELIVERY/BOUNCE/COMPLAINT/REJECT/RENDERING_FAILURE.
# LEAVE EMPTY unless the named set exists: SES rejects every send that names a
# configuration set it cannot find.
SES_CONFIGURATION_SET=
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY optional (default AWS credential chain)

# Rate limiting (requests / minute, per IP)
RATE_LIMIT_PER_MINUTE=120

# Platform admin token — required to call /api/v1/admin/products (create / list).
# Generate with: openssl rand -hex 32
PLATFORM_ADMIN_TOKEN=change-me-platform-admin-token
